<?xml version="1.0" ?>
<mujoco model="MSK-Bench Slide">
    <include file="../scene/msk_bench_scene.xml"/>
    <include file="../torso/assets/torso_assets.xml"/>
    <include file="../head/assets/head_simple_assets.xml"/>
    <include file="../leg/assets/leg_assets.xml"/>
    <include file="../leg/assets/leg_tendon.xml"/>
    <include file="../leg/assets/leg_muscle.xml"/>
    <include file="../arm/assets/arm_assets.xml"/>
    <include file="../arm/assets/arm_assets_left.xml"/> 

    <default>
        <default class="visual">
            <geom group="1" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
            <geom group="0" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>
        </default>
    </default>

    <asset>
        <mesh name="slide_mesh" vertex="0.3 5 0  0.3 -5 0  5.3 5 0.25  5.3 -5 0.25  10.3 5 0  10.3 -5 0"/>
        
        <texture name="tex_slide" type="2d" builtin="flat" width="1" height="1" rgb1="0.6 0.6 0.6"/>
        <material name="mat_slide" texture="tex_slide" specular="0.1" shininess="0.1"/>
    </asset>

    <option timestep="0.002" integrator="Euler" /> <compiler angle="radian" meshdir=".." texturedir=".."/>

    <worldbody>
        <body name="Full Body" pos="-0.5 0 0.95">
            <freejoint name="root"/>
            <include file="../torso/assets/torso_chain.xml"/>
            <include file="../leg/assets/leg_chain.xml"/>
        </body>

        <body name="slides_structure" pos="0 0 0">
            <geom type="mesh" mesh="slide_mesh" pos="0 0 0" material="mat_slide" class="collision"/>
            <geom type="mesh" mesh="slide_mesh" pos="10 0 0.8" material="mat_slide" class="collision"/> <geom type="mesh" mesh="slide_mesh" pos="20 0 1.6" material="mat_slide" class="collision"/>
            
            <geom type="mesh" mesh="slide_mesh" pos="0 0 0" material="mat_slide" class="visual"/>
            <geom type="mesh" mesh="slide_mesh" pos="10 0 0.8" material="mat_slide" class="visual"/>
            <geom type="mesh" mesh="slide_mesh" pos="20 0 1.6" material="mat_slide" class="visual"/>
        </body>

        <geom type="box" pos="15 -5.15 1" size="20 0.15 1" class="collision" rgba="0.8 0.8 0.8 0.5"/>
        <geom type="box" pos="15 5.15 1" size="20 0.15 1" class="collision" rgba="0.8 0.8 0.8 0.5"/>
        <geom type="box" pos="-4 0 4" size="0.15 5.15 4" class="collision" rgba="0.8 0.8 0.8 0.5"/>
    </worldbody>
</mujoco>