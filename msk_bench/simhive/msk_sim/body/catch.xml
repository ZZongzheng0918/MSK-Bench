<?xml version="1.0" ?>
<mujoco model="MSK-Bench Catch">
    <option timestep="0.002" integrator="Euler" iterations="50" solver="Newton">
        <flag eulerdamp="enable"/>
    </option>

    <compiler angle="radian" meshdir=".." texturedir=".."/>

    <default>
        <default class="visual">
            <geom group="2" contype="0" conaffinity="0"/>
        </default>
        <default class="collision">
            <geom group="3"/>
        </default>
        
        <default class="cube_part">
            <geom material="mat_cube" condim="3" friction="0.5 0.005 0.0001" gap="0.002" solref="0.01 1" solimp="0.9 0.95 0.001"/>
        </default>
    </default>

    <include file="../scene/msk_bench_scene.xml"/>
    <include file="../torso/assets/torso_assets.xml"/>
    <include file="../head/assets/head_simple_assets.xml"/>
    <include file="../leg/assets/leg_assets.xml"/>
    <include file="../leg/assets/leg_tendon.xml"/>
    <include file="../leg/assets/leg_muscle.xml"/>
    <include file="../arm/assets/arm_assets.xml"/>
    <include file="../arm/assets/arm_assets_left.xml"/> 

    <asset>
        <material name="mat_cube" rgba="0.2 0.8 0.2 1" specular="0.5" shininess="0.5"/>
    </asset>

    <worldbody>
        <body name="Full Body" pos="0 0 1.0">
            <freejoint name="root"/>
            <include file="../torso/assets/torso_chain.xml"/>
            <include file="../leg/assets/leg_chain.xml"/>
        </body>

        <body name="throw_cube" pos="1.0 0 1.0">
            <freejoint name="cube_joint"/>
            <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1" class="cube_part" rgba="0 1 0 1"/>
            
            <site name="cube_center" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
        </body>

    </worldbody>
</mujoco>