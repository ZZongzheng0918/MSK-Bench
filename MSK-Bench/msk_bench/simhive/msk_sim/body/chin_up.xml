<?xml version="1.0" ?>
<mujoco model="MSK-Bench ChinUp">
    <include file="../scene/msk_bench_scene.xml"/>
    <include file="../torso/assets/torso_assets.xml"/>
    <include file="../head/assets/head_simple_assets.xml"/>
    <include file="../leg/assets/leg_assets.xml"/>
    <include file="../leg/assets/leg_tendon.xml"/>
    <include file="../leg/assets/leg_muscle.xml"/>
    <include file="../arm/assets/arm_assets.xml"/>
    <include file="../arm/assets/arm_assets_left.xml"/> 

    <option timestep="0.002" integrator="Euler" />
    <compiler angle="radian" meshdir=".." texturedir=".."/>

    <asset>
        <material name="mat_bar" rgba="0.3 0.3 0.3 1" specular="0.8" shininess="0.8"/>
        <material name="mat_post" rgba="0.1 0.1 0.1 1" specular="0.2" shininess="0.2"/>
    </asset>

    <worldbody>
        <body name="Full Body" pos="0 0 1.25">
            <freejoint name="root"/>
            <include file="../torso/assets/torso_chain.xml"/>
            <include file="../leg/assets/leg_chain.xml"/>
        </body>

        <body name="HighBar" pos="0.35 0 2.3">
            <geom name="bar_geom" type="cylinder" size="0.02 0.6" zaxis="0 1 0" material="mat_bar" condim="6"/>
            <geom name="post_l" type="cylinder" pos="0 0.6 -1.15" size="0.04 1.15" material="mat_post" />
            <geom name="post_r" type="cylinder" pos="0 -0.6 -1.15" size="0.04 1.15" material="mat_post" />
        </body>
    </worldbody>

    <equality>
        <weld name="weld_l" body1="lunate_l" body2="HighBar" relpose="-0.02 0.15 -0.05 1 0 0 0" solimp="0.9 0.95 0.001" solref="0.02 1"/>
        <weld name="weld_r" body1="lunate" body2="HighBar" relpose="-0.02 -0.15 -0.05 1 0 0 0" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    </equality>

    <contact>
        <exclude body1="Full Body" body2="HighBar"/>
    </contact>
</mujoco>